# Copy to /etc/zenmoney-mcp/server.env (root:root, mode 0600).
# Add ZENMONEY_TOKEN here, or store it in private config.json under STATE_DIR.
ZENMONEY_STATE_DIR=/var/lib/zenmoney-mcp
ZENMONEY_MCP_RESOURCE=https://budget.theblackhaired.ru/mcp
ZENMONEY_OAUTH_ISSUER=https://auth.theblackhaired.ru/auth/realms/master
ZENMONEY_OAUTH_JWKS_URL=https://auth.theblackhaired.ru/auth/realms/master/protocol/openid-connect/certs
# Set to the exact sub of theblackhaired in the master realm:
# ZENMONEY_OAUTH_SUBJECT=<exact sub claim>
