[Unit]
Description=ZenMoney remote MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kgorosov
Group=kgorosov
WorkingDirectory=/home/kgorosov/apps/zenmoney-mcp/current
EnvironmentFile=/etc/zenmoney-mcp/server.env
ExecStart=/home/kgorosov/apps/zenmoney-mcp/current/.venv/bin/python -m uvicorn zenmoney_mcp.remote:create_app --factory --host 127.0.0.1 --port 8769
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=zenmoney-mcp
StateDirectoryMode=0700
ReadWritePaths=/var/lib/zenmoney-mcp

[Install]
WantedBy=multi-user.target
